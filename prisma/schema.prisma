generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  password    String?  // optional kalau pakai SSO
  role        Role     @default(PARTICIPANT)
  proposals   Proposal[]
  juryEvaluations JuryEvaluation[]
  createdAt   DateTime @default(now())

  @@map("users")
}

model Proposal {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id])
  userId       String
  title        String
  problem      String
  solution     String
  documentUrl  String    // link ke file di S3/Supabase
  status       ProposalStatus @default(SUBMITTED)
  feedback     String?
  submittedAt  DateTime  @default(now())
  aiScore      AiEvaluation?
  revisions    Revision[]
  juryScores   JuryEvaluation[]

  @@map("proposals")
}

model AiEvaluation {
  id          String   @id @default(cuid())
  proposal    Proposal @relation(fields: [proposalId], references: [id])
  proposalId  String   @unique
  scoreJson   Json     // JSON hasil skoring
  classification String // Breakthrough / Improvement
  flagged      Boolean @default(false) // plagiarisme / duplikat
  createdAt    DateTime @default(now())

  @@map("ai_evaluations")
}

model JuryEvaluation {
  id          String   @id @default(cuid())
  proposal    Proposal @relation(fields: [proposalId], references: [id])
  proposalId  String
  jury        User     @relation(fields: [juryId], references: [id])
  juryId      String
  scoreJson   Json     // format skoring manual
  comment     String?
  createdAt   DateTime @default(now())

  @@map("jury_evaluations")
}

model Revision {
  id          String   @id @default(cuid())
  proposal    Proposal @relation(fields: [proposalId], references: [id])
  proposalId  String
  note        String
  documentUrl String
  createdAt   DateTime @default(now())

  @@map("revisions")
}

enum Role {
  PARTICIPANT
  JURY
  ADMIN
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  NEEDS_REVISION
  REVISED
  SELECTED
  REJECTED
}
